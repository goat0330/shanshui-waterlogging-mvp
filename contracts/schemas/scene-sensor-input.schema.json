{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneSensorInput",
  "type": "object",
  "required": ["id", "type", "coordinates", "depthCm", "visualState", "selected"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["WATER_LEVEL_SENSOR"]},
    "coordinates": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}},
      "additionalProperties": false
    },
    "depthCm": {"type": "number", "minimum": 0},
    "visualState": {"enum": ["NORMAL", "WARNING", "HIGH", "CRITICAL"]},
    "selected": {"type": "boolean"}
  },
  "additionalProperties": false
}
