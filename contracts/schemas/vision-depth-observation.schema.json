{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanshui.local/contracts/vision-depth-observation.schema.json",
  "title": "VisionDepthObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imageId",
    "source",
    "provenance",
    "floodDetected",
    "depth",
    "method",
    "referenceObjects",
    "waterMaskPath",
    "quality",
    "qualityFlags",
    "model",
    "synthetic"
  ],
  "properties": {
    "imageId": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string", "enum": ["url", "local"]},
        "value": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId", "observedAt", "licenseReview", "runtimePolicy"],
      "properties": {
        "sourceType": {"type": "string", "enum": ["VISION_IMAGE", "VISION_VIDEO"]},
        "sourceId": {"type": "string", "minLength": 1},
        "observedAt": {"type": ["string", "null"], "format": "date-time"},
        "licenseReview": {"type": "string", "enum": ["approved", "pending", "not_required"]},
        "runtimePolicy": {"type": "string", "enum": ["research_mvp", "production"]}
      }
    },
    "floodDetected": {"type": "boolean"},
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "estimatedDepthCm", "rangeCm", "confidence"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 5},
        "estimatedDepthCm": {"type": ["number", "null"], "minimum": 0},
        "approximateDepthCm": {"type": ["number", "null"], "minimum": 0},
        "rangeCm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": ["number", "null"]}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "method": {
      "type": "string",
      "enum": ["VISUAL_RANGE", "NO_REFERENCE", "PERSON_REFERENCE", "VEHICLE_REFERENCE", "TRAFFIC_SIGN_REFERENCE", "FIXED_CAMERA_REFERENCE"]
    },
    "referenceObjects": {"type": "array", "items": {"type": "object"}},
    "waterMaskPath": {"type": "string"},
    "quality": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "REJECT"]},
    "qualityFlags": {"type": "array", "items": {"type": "string"}},
    "model": {"type": "object"},
    "synthetic": {"type": "boolean"}
  }
}
