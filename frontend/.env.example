# API mode uses same-origin /api and /ws by default; Vite proxies to backend :8000.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_CESIUM_ION_TOKEN=replace-with-your-cesium-ion-token
VITE_DEMO_VIDEO_URL=/runtime/vision-video/VF-LSU-20200624-1.mp4
VITE_DEMO_VIDEO_OVERLAY_URL=/runtime/vision-video/VF-LSU-20200624-1.overlay.json
