# Non-secret local examples only. This project does not load .env automatically.
REPOSITORY_BACKEND=memory
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/shanshui
DATA_MODE=fixture
SHANGHAI_WATER_TIMEOUT_SECONDS=8
SHANGHAI_WATER_CACHE_TTL_SECONDS=45
SHANGHAI_WATER_POLL_INTERVAL_SECONDS=60
SHANGHAI_WATER_HISTORY_POINTS=144
# Built-in public meteorology providers (Shanghai defaults). Override only when needed.
NMC_STATION_ID=58367
NMC_ALARM_PROVINCE=上海市
METEOROLOGY_LAT=31.2304
METEOROLOGY_LON=121.4737
METEOROLOGY_POLL_INTERVAL_SECONDS=360
# Optional provider overrides. Blank values use NMC warning/current/radar-preview and China Weather minute nowcast.
NMC_WEATHER_URL=
CMA_WARNING_URL=
CMA_NOWCAST_URL=
CHINA_WEATHER_MINUTE_URL_TEMPLATE=
CMA_TIMEOUT_SECONDS=8

# Optional override. If unset, the pipeline also checks project-local/sibling data research paths.
VISION_WATER_SEGMENTATION_CHECKPOINT=

# Optional reviewed precomputed SWMM scenario catalog.
FORECAST_SCENARIO_CATALOG=
